{
  "compilerOptions": {
    "target": "ES2021",
    "module": "ESNext",
    "lib": ["ES2021", "DOM", "DOM.Iterable"],
    "declaration": true,
    "outDir": "./dist",
    "rootDir": "./app",
    "strict": false,
    "allowJs": true,
    "checkJs": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "moduleResolution": "bundler",
    "types": ["jquery", "underscore"],
    "typeRoots": ["./app/types", "./node_modules/@types"],
    "paths": {
      "@components/*": ["./app/components/*"],
      "@entities/*": ["./app/components/entities/*"],
      "@mathstools/*": ["./app/components/exercices/tools/maths/*"],
      "@exocode/*": ["./app/components/exercices/tools/exocode/*"],
      "@styles/*": ["./app/styles/*"],
      "@common/*": ["./app/components/common/*"],
      "@templates/*": ["./app/templates/*"],
      "@types": ["./app/components/types"],
      "@types/*": ["./app/components/types/*"]
    }
  },
  "include": ["app/**/*.ts", "app/**/*.tsx"],
  "exclude": ["node_modules", "public", "dist"]
}
