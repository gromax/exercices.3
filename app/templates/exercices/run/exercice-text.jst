<div class="card <%if (info) { %>text-bg-info<% } else if (warning) {%>text-bg-warning<% }%> mb-3">
  <% if(header) {%><h5 class="card-header"><%- header %></h5><% } %>
  <div class="card-body">
    <% if(subtitle) {%><h5 class="card-title"><%- subtitle %></h5><% } %>
    <% _.each(paragraphs, function(p) { %><p class="card-text <%- p.style %>"><%= p.text %></p><% }); %>
  </div>
  <% if(footer) {%><div class="card-footer text-muted"><%- footer %></div><% } %>
</div>