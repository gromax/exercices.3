<% if ((typeof button !== "undefined") && button) { %>
    <button type="button" class="list-group-item list-group-item-action js-choice-button">
        <% if (tag) {%>
            <%- tag %>&emsp;<%- caption %>
        <% } else { %>
            <i class="fa-solid fa-<%- picto %> fa-2x" style="color:<%- color %>; ; vertical-align: middle;"></i>&emsp;<%- caption %>
        <% } %>
    </button>
<% } else if ((typeof good !== "undefined") && (good)) { %>
    <li class="list-group-item list-group-item-success">
        <% if (tag) { %>
            <%- tag %> <i class="fa-solid fa-check"></i>
        <% } else { %>
            <span class="fa-stack">
                <i class="fa-solid fa-<%- picto %> fa-stack-2x" style="color:<%- color %>;"></i>
                <i class="fa-solid fa-check fa-stack-1x fa-inverse"></i>
            </span>
        <% } %>
        &emsp;<%- caption %>
    </li>
<% } else if ((typeof good !== "undefined") && (!good)) { %>
    <li class="list-group-item list-group-item-danger">
        <% if (tag) { %>
            <%- tag %> <i class="fa-solid fa-xmark"></i>
        <% } else { %>
            <span class="fa-stack">
                <i class="fa-solid fa-<%- picto %> fa-stack-2x" style="color:<%- color %>;"></i>
                <i class="fa-solid fa-xmark fa-stack-1x fa-inverse"></i>
            </span>
        <% } %>
        &emsp;
        <% if (!goodTag) { %>
            <i class="fa-solid fa-<%- goodpicto %> fa-2x" style="color:<%- goodcolor %>; vertical-align: middle;"></i>
        <% } %>
        &emsp;<%- caption %>
        <% if (goodTag) { %>
            &emsp;(réponse :<%- goodTag %> <i class="fa-solid fa-check"></i>)
        <% } %>
    </li>
<% } else { %>
    <li class="list-group-item">
        <% if (tag) { %>
            <%- tag %>
        <% } else { %>
            <i class="fa-solid fa-<%- picto %> fa-2x" style="color:<%- color %>; vertical-align: middle;"></i>
        <% } %>
        &emsp;<%- caption %>
    </li>
<% } %>